# Neon PostgreSQL - use pooled connection URL for app, direct for migrations
DATABASE_URL="your-neon-url-here"
DATABASE_URL_UNPOOLED="your-neon-unpooled-url-here"

# App
NEXT_PUBLIC_BASE_URL="your-base-url-here"

# Optional: Cloudflare R2 (for logos in production)
R2_ACCOUNT_ID="your-r2-account-id-here"
R2_ACCESS_KEY_ID="your-r2-access-key-id-here"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key-here"
R2_BUCKET_NAME="your-r2-bucket-name-here"
